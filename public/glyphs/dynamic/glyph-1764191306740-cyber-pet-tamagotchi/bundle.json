{
  "name": "Cyber-Pet Tamagotchi",
  "type": "object",
  "entry": "index.html",
  "files": {
    "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Cyber-Pet</title>\n    <style>\n        html, body { margin: 0; padding: 0; width: 100%; height: 100%; background: transparent; overflow: hidden; font-family: 'Courier New', Courier, monospace; }\n        canvas { display: block; width: 100%; height: 100%; outline: none; }\n        \n        /* HUD Overlay */\n        #hud {\n            position: absolute;\n            top: 20px;\n            left: 20px;\n            width: 220px;\n            pointer-events: none;\n            user-select: none;\n            z-index: 10;\n        }\n        .stat-row {\n            margin-bottom: 15px;\n        }\n        .label { color: #00ffff; font-size: 12px; margin-bottom: 4px; text-shadow: 0 0 5px #00ffff; font-weight: bold; }\n        .bar-bg {\n            width: 100%; height: 8px;\n            background: rgba(0, 255, 255, 0.1);\n            border: 1px solid #00ffff;\n            box-shadow: 0 0 5px rgba(0, 255, 255, 0.2);\n        }\n        .bar-fill {\n            height: 100%;\n            width: 100%;\n            background: #00ffff;\n            box-shadow: 0 0 10px #00ffff;\n            transition: width 0.2s, background-color 0.5s;\n        }\n\n        /* Controls */\n        #controls {\n            position: absolute;\n            bottom: 30px;\n            width: 100%;\n            text-align: center;\n            pointer-events: none;\n            z-index: 10;\n        }\n        button {\n            pointer-events: auto;\n            background: rgba(0,0,0,0.8);\n            border: 1px solid #ff00ff;\n            color: #ff00ff;\n            padding: 12px 24px;\n            font-family: inherit;\n            font-size: 14px;\n            font-weight: bold;\n            text-transform: uppercase;\n            cursor: pointer;\n            transition: all 0.2s;\n            box-shadow: 0 0 10px rgba(255, 0, 255, 0.3);\n            margin: 0 10px;\n        }\n        button:hover {\n            background: #ff00ff;\n            color: #000;\n            box-shadow: 0 0 20px #ff00ff;\n        }\n        button:active {\n            transform: scale(0.95);\n        }\n\n        /* Status Text */\n        #status {\n            position: absolute;\n            top: 50%;\n            width: 100%;\n            text-align: center;\n            font-size: 24px;\n            font-weight: bold;\n            color: #ff0000;\n            text-shadow: 0 0 10px #ff0000;\n            pointer-events: none;\n            opacity: 0;\n            transition: opacity 0.5s;\n            transform: translateY(-50%);\n        }\n        \n        .instruction {\n            font-size: 10px; color: #aaa; margin-top: 8px; text-shadow: none;\n        }\n    </style>\n</head>\n<body>\n    <div id=\"hud\">\n        <div class=\"stat-row\">\n            <div class=\"label\">INTEGRITY (HUNGER)</div>\n            <div class=\"bar-bg\"><div id=\"bar-hunger\" class=\"bar-fill\"></div></div>\n        </div>\n        <div class=\"stat-row\">\n            <div class=\"label\">SYNC_RATE (HAPPINESS)</div>\n            <div class=\"bar-bg\"><div id=\"bar-happy\" class=\"bar-fill\"></div></div>\n        </div>\n        <div class=\"stat-row\">\n             <div class=\"label\">MASS: <span id=\"mass-val\">1.00</span> TB</div>\n        </div>\n    </div>\n\n    <div id=\"status\">CRITICAL SYSTEM FAILURE<br><span style=\"font-size:14px\">SUBJECT IS UPSET</span></div>\n\n    <div id=\"controls\">\n        <button id=\"btn-feed\">Inject Data (Feed)</button>\n        <div class=\"instruction\">RUB CURSOR ON SUBJECT TO PET • FEED TO GROW</div>\n    </div>\n\n    <script type=\"module\">\n        import * as THREE from 'https://esm.sh/three@0.168.0';\n        import { OrbitControls } from 'https://esm.sh/three@0.168.0/examples/jsm/controls/OrbitControls.js';\n\n        // --- STATE ---\n        const state = {\n            hunger: 100,      // 0 = Starving, 100 = Full\n            happiness: 100,   // 0 = Depressed, 100 = Ecstatic\n            size: 1.0,        // Growth multiplier\n            isUpset: false,\n            lastPetTime: 0\n        };\n\n        // --- SETUP ---\n        const scene = new THREE.Scene();\n        // scene.background = new THREE.Color(0x050505);\n        // Transparent background requested, but let's add some fog for depth\n        scene.fog = new THREE.FogExp2(0x000000, 0.02);\n\n        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);\n        camera.position.set(4, 3, 6);\n\n        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n        renderer.setSize(window.innerWidth, window.innerHeight);\n        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n        document.body.appendChild(renderer.domElement);\n\n        const controls = new OrbitControls(camera, renderer.domElement);\n        controls.enableDamping = true;\n        controls.enablePan = false;\n        controls.minDistance = 2;\n        controls.maxDistance = 15;\n\n        // --- LIGHTS ---\n        const ambientLight = new THREE.AmbientLight(0x404040, 2);\n        scene.add(ambientLight);\n\n        const dirLight = new THREE.DirectionalLight(0xffffff, 2);\n        dirLight.position.set(5, 10, 7);\n        scene.add(dirLight);\n\n        const pointLight = new THREE.PointLight(0x00ffff, 3, 10);\n        pointLight.position.set(0, 2, 2);\n        scene.add(pointLight);\n\n        // --- MATERIALS ---\n        const bodyMat = new THREE.MeshStandardMaterial({ \n            color: 0x111111, \n            roughness: 0.2, \n            metalness: 0.8,\n            emissive: 0x00ffff,\n            emissiveIntensity: 0.2\n        });\n        \n        const jointMat = new THREE.MeshStandardMaterial({ \n            color: 0x222222, \n            roughness: 0.5 \n        });\n\n        const eyeMat = new THREE.MeshStandardMaterial({ \n            color: 0x000000,\n            emissive: 0x00ffff,\n            emissiveIntensity: 2\n        });\n\n        // --- PET CONSTRUCTION (The \"Cyber-Dog\") ---\n        const dogGroup = new THREE.Group();\n        scene.add(dogGroup);\n\n        // Body\n        const bodyGeo = new THREE.BoxGeometry(1, 0.8, 1.5);\n        const body = new THREE.Mesh(bodyGeo, bodyMat.clone());\n        body.position.y = 0.8;\n        dogGroup.add(body);\n\n        // Head Group\n        const headGroup = new THREE.Group();\n        headGroup.position.set(0, 1.4, 0.9);\n        dogGroup.add(headGroup);\n\n        // Head Mesh\n        const headGeo = new THREE.BoxGeometry(0.7, 0.7, 0.8);\n        const head = new THREE.Mesh(headGeo, bodyMat.clone());\n        headGroup.add(head);\n\n        // Eyes\n        const eyeGeo = new THREE.SphereGeometry(0.1, 16, 16);\n        const leftEye = new THREE.Mesh(eyeGeo, eyeMat.clone());\n        leftEye.position.set(0.2, 0.1, 0.4);\n        headGroup.add(leftEye);\n        \n        const rightEye = new THREE.Mesh(eyeGeo, eyeMat.clone());\n        rightEye.position.set(-0.2, 0.1, 0.4);\n        headGroup.add(rightEye);\n\n        // Ears\n        const earGeo = new THREE.ConeGeometry(0.15, 0.4, 4);\n        const leftEar = new THREE.Mesh(earGeo, bodyMat.clone());\n        leftEar.position.set(0.25, 0.5, 0);\n        leftEar.rotation.x = -0.2;\n        leftEar.rotation.z = -0.2;\n        headGroup.add(leftEar);\n\n        const rightEar = new THREE.Mesh(earGeo, bodyMat.clone());\n        rightEar.position.set(-0.25, 0.5, 0);\n        rightEar.rotation.x = -0.2;\n        rightEar.rotation.z = 0.2;\n        headGroup.add(rightEar);\n\n        // Legs\n        const legGeo = new THREE.CylinderGeometry(0.15, 0.1, 0.8);\n        const legs = [];\n        const legPos = [\n            {x: 0.35, z: 0.5}, {x: -0.35, z: 0.5},\n            {x: 0.35, z: -0.5}, {x: -0.35, z: -0.5}\n        ];\n        legPos.forEach(pos => {\n            const leg = new THREE.Mesh(legGeo, jointMat);\n            leg.position.set(pos.x, 0.4, pos.z);\n            dogGroup.add(leg);\n            legs.push(leg);\n        });\n\n        // Tail\n        const tailGroup = new THREE.Group();\n        tailGroup.position.set(0, 1, -0.75);\n        dogGroup.add(tailGroup);\n        const tailGeo = new THREE.BoxGeometry(0.15, 0.15, 0.6);\n        const tail = new THREE.Mesh(tailGeo, bodyMat.clone());\n        tail.position.set(0, 0.1, -0.3);\n        tail.rotation.x = 0.4;\n        tailGroup.add(tail);\n\n        // Floor Grid\n        const gridHelper = new THREE.GridHelper(20, 20, 0x333333, 0x111111);\n        scene.add(gridHelper);\n\n        // --- INTERACTIVITY ---\n        const raycaster = new THREE.Raycaster();\n        const mouse = new THREE.Vector2();\n        let isHovering = false;\n        let petVelocity = 0;\n\n        window.addEventListener('mousemove', (event) => {\n            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;\n            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;\n\n            // Petting detection: Raycast\n            raycaster.setFromCamera(mouse, camera);\n            const intersects = raycaster.intersectObjects(dogGroup.children, true);\n            \n            if (intersects.length > 0) {\n                document.body.style.cursor = 'grab';\n                isHovering = true;\n                \n                // Calculate \"rubbing\" velocity\n                petVelocity += Math.abs(event.movementX) + Math.abs(event.movementY);\n            } else {\n                document.body.style.cursor = 'default';\n                isHovering = false;\n            }\n        });\n\n        // Feed Button\n        document.getElementById('btn-feed').addEventListener('click', () => {\n            spawnFood();\n        });\n\n        // Food Logic\n        const foods = [];\n        const foodGeo = new THREE.BoxGeometry(0.3, 0.3, 0.3);\n        const foodMat = new THREE.MeshBasicMaterial({ color: 0xff00ff, wireframe: true });\n\n        function spawnFood() {\n            if (state.hunger >= 120) return; // Don't overfeed too much\n\n            const food = new THREE.Mesh(foodGeo, foodMat);\n            // Random position above\n            food.position.set(\n                (Math.random() - 0.5) * 4,\n                4,\n                (Math.random() - 0.5) * 4\n            );\n            scene.add(food);\n            foods.push({ mesh: food, velocity: new THREE.Vector3(0, -0.1, 0) });\n        }\n\n        // --- ANIMATION LOOP ---\n        const clock = new THREE.Clock();\n        let time = 0;\n\n        function updateState(dt) {\n            // Decay stats\n            state.hunger = Math.max(0, state.hunger - 2 * dt);\n            state.happiness = Math.max(0, state.happiness - 1.5 * dt);\n\n            // Petting Logic\n            if (petVelocity > 0) {\n                state.happiness = Math.min(100, state.happiness + petVelocity * 0.1);\n                petVelocity *= 0.9; // dampening\n                \n                // Visual feedback for petting\n                headGroup.rotation.z = Math.sin(time * 20) * 0.1;\n            }\n\n            // Check upset state\n            const wasUpset = state.isUpset;\n            state.isUpset = (state.hunger < 20 || state.happiness < 20);\n\n            // Update UI\n            document.getElementById('bar-hunger').style.width = state.hunger + '%';\n            document.getElementById('bar-happy').style.width = state.happiness + '%';\n            document.getElementById('mass-val').innerText = state.size.toFixed(2);\n\n            // Color feedback\n            const targetColor = state.isUpset ? new THREE.Color(0xff0000) : new THREE.Color(0x00ffff);\n            const targetEmissive = state.isUpset ? new THREE.Color(0xff0000) : new THREE.Color(0x00ffff);\n            \n            // Smoothly change eye color\n            leftEye.material.emissive.lerp(targetEmissive, 0.1);\n            rightEye.material.emissive.lerp(targetEmissive, 0.1);\n            \n            // Body glow\n            body.material.emissive.lerp(targetEmissive, 0.05);\n            head.material.emissive.lerp(targetEmissive, 0.05);\n\n            // HUD Bar colors\n            const barColor = state.isUpset ? '#ff0000' : '#00ffff';\n            document.querySelectorAll('.bar-fill').forEach(el => el.style.backgroundColor = barColor);\n\n            // Status Text\n            document.getElementById('status').style.opacity = state.isUpset ? 1 : 0;\n        }\n\n        function animate() {\n            requestAnimationFrame(animate);\n            \n            const dt = clock.getDelta();\n            time += dt;\n\n            updateState(dt);\n            controls.update();\n\n            // --- DOG ANIMATION ---\n            \n            // Breathing\n            const breath = Math.sin(time * 2) * 0.05;\n            body.scale.y = 1 + breath;\n            body.position.y = 0.8 + breath * 0.5;\n            headGroup.position.y = 1.4 + breath * 0.5;\n\n            // Tail Wag\n            let wagSpeed = state.isUpset ? 0.5 : 5;\n            if (state.happiness > 80) wagSpeed = 15;\n            tailGroup.rotation.y = Math.sin(time * wagSpeed) * 0.5;\n\n            // Look at camera (Head tracking)\n            const lookTarget = new THREE.Vector3(camera.position.x, camera.position.y, camera.position.z);\n            headGroup.lookAt(lookTarget);\n            // Clamp head rotation so it doesn't break neck\n            headGroup.rotation.x = THREE.MathUtils.clamp(headGroup.rotation.x, -0.5, 0.5);\n            headGroup.rotation.z = THREE.MathUtils.clamp(headGroup.rotation.z, -0.5, 0.5);\n            // Add petting shake\n            if (isHovering && petVelocity > 5) {\n                headGroup.rotation.z += Math.sin(time * 50) * 0.1;\n            }\n\n            // Growth Scale\n            const targetScale = state.size;\n            dogGroup.scale.lerp(new THREE.Vector3(targetScale, targetScale, targetScale), 0.05);\n\n            // --- FOOD PHYSICS ---\n            for (let i = foods.length - 1; i >= 0; i--) {\n                const f = foods[i];\n                \n                // Move towards dog mouth\n                const mouthPos = new THREE.Vector3();\n                headGroup.getWorldPosition(mouthPos);\n                mouthPos.y -= 0.2; // Adjust to mouth level\n                mouthPos.z += 0.5;\n\n                const dir = new THREE.Vector3().subVectors(mouthPos, f.mesh.position).normalize();\n                f.mesh.position.add(dir.multiplyScalar(0.15));\n                f.mesh.rotation.x += 0.1;\n                f.mesh.rotation.y += 0.1;\n\n                // Eat detection\n                if (f.mesh.position.distanceTo(mouthPos) < 0.5) {\n                    scene.remove(f.mesh);\n                    foods.splice(i, 1);\n                    \n                    // Effect of eating\n                    state.hunger = Math.min(100, state.hunger + 20);\n                    state.size += 0.05; // Grow!\n                    \n                    // Happy jump\n                    dogGroup.position.y += 0.5;\n                }\n            }\n\n            // Gravity for dog jump\n            if (dogGroup.position.y > 0) {\n                dogGroup.position.y = Math.max(0, dogGroup.position.y - 0.1);\n            }\n\n            renderer.render(scene, camera);\n        }\n\n        // Handle Window Resize\n        window.addEventListener('resize', () => {\n            camera.aspect = window.innerWidth / window.innerHeight;\n            camera.updateProjectionMatrix();\n            renderer.setSize(window.innerWidth, window.innerHeight);\n        });\n\n        animate();\n    </script>\n</body>\n</html>"
  }
}