{
  "name": "Neon Apple",
  "type": "object",
  "entry": "index.html",
  "files": {
    "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Neon Apple</title>\n    <style>\n        html, body {\n            margin: 0;\n            padding: 0;\n            width: 100%;\n            height: 100%;\n            background: transparent;\n            overflow: hidden;\n            font-family: 'Courier New', Courier, monospace;\n        }\n        canvas {\n            display: block;\n            width: 100%;\n            height: 100%;\n        }\n        #ui {\n            position: absolute;\n            bottom: 20px;\n            left: 20px;\n            color: #00ffff;\n            font-size: 12px;\n            pointer-events: none;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            text-shadow: 0 0 5px #00ffff;\n        }\n        .key {\n            display: inline-block;\n            border: 1px solid #00ffff;\n            padding: 2px 6px;\n            margin: 0 2px;\n            border-radius: 2px;\n            background: rgba(0, 255, 255, 0.1);\n        }\n    </style>\n</head>\n<body>\n    <canvas id=\"scene\"></canvas>\n    <div id=\"ui\">\n        State: <span id=\"status\">IDLE</span><br>\n        Input: <span id=\"coords\">0, 0</span><br>\n        Action: <span class=\"key\">LMB</span> to BIT/GLITCH\n    </div>\n\n    <script type=\"module\">\n        import * as THREE from 'https://esm.sh/three@0.168.0';\n\n        // --- CONFIGURATION ---\n        const COLORS = {\n            skin: 0xff0066,    // Neon Pink\n            stem: 0x88ff00,    // Neon Green\n            leaf: 0x00ffff,    // Cyan\n            glitch: 0xffffff,  // White\n            bg: 0x050505\n        };\n\n        // --- STATE ---\n        const state = {\n            mouseX: 0,\n            mouseY: 0,\n            targetRotationX: 0,\n            targetRotationY: 0,\n            isGlitching: false,\n            time: 0\n        };\n\n        // --- SCENE SETUP ---\n        const canvas = document.getElementById('scene');\n        const uiStatus = document.getElementById('status');\n        const uiCoords = document.getElementById('coords');\n\n        const scene = new THREE.Scene();\n        // Transparent background for iframe integration\n        scene.background = null; \n\n        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);\n        camera.position.z = 8;\n\n        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });\n        renderer.setSize(window.innerWidth, window.innerHeight);\n        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n        renderer.toneMapping = THREE.ACESFilmicToneMapping;\n        renderer.outputColorSpace = THREE.SRGBColorSpace;\n\n        // --- GEOMETRY GENERATION (Procedural Apple) ---\n        const appleGroup = new THREE.Group();\n        scene.add(appleGroup);\n\n        // 1. Apple Body using LatheGeometry\n        const points = [];\n        // Draw the profile of half an apple\n        points.push(new THREE.Vector2(0, -1.5));      // Bottom center\n        points.push(new THREE.Vector2(0.5, -1.45));   // Bottom curve\n        points.push(new THREE.Vector2(1.3, -0.8));    // Wide bottom\n        points.push(new THREE.Vector2(1.5, 0.3));     // Mid bulge\n        points.push(new THREE.Vector2(1.3, 1.1));     // Upper shoulder\n        points.push(new THREE.Vector2(0.4, 1.4));     // Top curve\n        points.push(new THREE.Vector2(0, 1.2));       // Top center (dip)\n\n        const appleGeo = new THREE.LatheGeometry(points, 32);\n        const appleMat = new THREE.MeshPhysicalMaterial({\n            color: COLORS.skin,\n            emissive: 0x220011,\n            metalness: 0.5,\n            roughness: 0.2,\n            clearcoat: 1.0,\n            clearcoatRoughness: 0.1,\n            flatShading: false,\n            side: THREE.DoubleSide\n        });\n        const appleMesh = new THREE.Mesh(appleGeo, appleMat);\n        appleGroup.add(appleMesh);\n\n        // Wireframe overlay for cyberpunk feel\n        const wireGeo = new THREE.WireframeGeometry(appleGeo);\n        const wireMat = new THREE.LineBasicMaterial({ color: 0xff00aa, transparent: true, opacity: 0.1 });\n        const wireMesh = new THREE.LineSegments(wireGeo, wireMat);\n        appleMesh.add(wireMesh);\n\n        // 2. Stem\n        const stemGeo = new THREE.CylinderGeometry(0.08, 0.05, 0.8, 8);\n        stemGeo.translate(0, 1.6, 0);\n        // Curve the stem slightly by moving top vertices\n        const stemPos = stemGeo.attributes.position;\n        for(let i=0; i<stemPos.count; i++){\n            if(stemPos.getY(i) > 1.5) {\n                stemPos.setX(i, stemPos.getX(i) + 0.2);\n            }\n        }\n        stemGeo.computeVertexNormals();\n        \n        const stemMat = new THREE.MeshStandardMaterial({ color: 0x444444, roughness: 0.8 });\n        const stemMesh = new THREE.Mesh(stemGeo, stemMat);\n        appleGroup.add(stemMesh);\n\n        // 3. Leaf (Neon)\n        const leafShape = new THREE.Shape();\n        leafShape.moveTo(0, 0);\n        leafShape.quadraticCurveTo(0.5, 0.5, 0, 1);\n        leafShape.quadraticCurveTo(-0.5, 0.5, 0, 0);\n        \n        const leafGeo = new THREE.ExtrudeGeometry(leafShape, { depth: 0.02, bevelEnabled: true, bevelThickness: 0.02, bevelSize: 0.02, bevelSegments: 2 });\n        leafGeo.translate(0, 1.5, 0);\n        leafGeo.rotateZ(-0.5);\n        leafGeo.rotateY(0.5);\n\n        // Holographic Shader for Leaf\n        const leafMat = new THREE.ShaderMaterial({\n            uniforms: {\n                time: { value: 0 },\n                color: { value: new THREE.Color(COLORS.leaf) }\n            },\n            vertexShader: `\n                varying vec2 vUv;\n                varying vec3 vNormal;\n                void main() {\n                    vUv = uv;\n                    vNormal = normal;\n                    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n                }\n            `,\n            fragmentShader: `\n                uniform float time;\n                uniform vec3 color;\n                varying vec2 vUv;\n                varying vec3 vNormal;\n                void main() {\n                    float scanline = sin(vUv.y * 50.0 - time * 5.0) * 0.5 + 0.5;\n                    float rim = pow(1.0 - max(0.0, dot(vNormal, vec3(0,0,1))), 3.0);\n                    gl_FragColor = vec4(color * (0.5 + scanline * 0.5) + rim, 0.8);\n                }\n            `,\n            transparent: true,\n            side: THREE.DoubleSide\n        });\n\n        const leafMesh = new THREE.Mesh(leafGeo, leafMat);\n        appleGroup.add(leafMesh);\n\n        // --- LIGHTING ---\n        const ambientLight = new THREE.AmbientLight(0x404040, 2);\n        scene.add(ambientLight);\n\n        const dirLight = new THREE.DirectionalLight(0xffffff, 2);\n        dirLight.position.set(5, 5, 5);\n        scene.add(dirLight);\n\n        const rimLight = new THREE.PointLight(COLORS.leaf, 5, 10);\n        rimLight.position.set(-3, 2, -3);\n        scene.add(rimLight);\n\n        const fillLight = new THREE.PointLight(COLORS.skin, 3, 10);\n        fillLight.position.set(3, -2, 3);\n        scene.add(fillLight);\n\n        // --- INPUT HANDLING ---\n        const updateMouse = (e) => {\n            // Normalize mouse -1 to 1\n            state.mouseX = (e.clientX / window.innerWidth) * 2 - 1;\n            state.mouseY = -(e.clientY / window.innerHeight) * 2 + 1;\n            \n            state.targetRotationY = state.mouseX * Math.PI; // Rotate around Y based on X\n            state.targetRotationX = state.mouseY * 0.5;     // Tilt based on Y\n\n            uiCoords.innerText = `${state.mouseX.toFixed(2)}, ${state.mouseY.toFixed(2)}`;\n        };\n\n        const onMouseDown = () => {\n            state.isGlitching = true;\n            uiStatus.innerText = \"GLITCHING\";\n            uiStatus.style.color = \"#ff0000\";\n            appleMat.emissive.setHex(COLORS.glitch);\n            appleMat.emissiveIntensity = 2.0;\n        };\n\n        const onMouseUp = () => {\n            state.isGlitching = false;\n            uiStatus.innerText = \"IDLE\";\n            uiStatus.style.color = \"#00ffff\";\n            appleMat.emissive.setHex(0x220011);\n            appleMat.emissiveIntensity = 1.0;\n            // Reset scale\n            appleGroup.scale.set(1, 1, 1);\n        };\n\n        window.addEventListener('mousemove', updateMouse);\n        window.addEventListener('mousedown', onMouseDown);\n        window.addEventListener('mouseup', onMouseUp);\n        \n        // Touch support\n        window.addEventListener('touchmove', (e) => updateMouse(e.touches[0]));\n        window.addEventListener('touchstart', onMouseDown);\n        window.addEventListener('touchend', onMouseUp);\n\n        window.addEventListener('resize', () => {\n            camera.aspect = window.innerWidth / window.innerHeight;\n            camera.updateProjectionMatrix();\n            renderer.setSize(window.innerWidth, window.innerHeight);\n        });\n\n        // --- ANIMATION LOOP ---\n        const clock = new THREE.Clock();\n\n        function animate() {\n            requestAnimationFrame(animate);\n            \n            const delta = clock.getDelta();\n            state.time += delta;\n\n            // Smooth rotation interpolation\n            appleGroup.rotation.y += (state.targetRotationY - appleGroup.rotation.y) * 5 * delta;\n            appleGroup.rotation.x += (state.targetRotationX - appleGroup.rotation.x) * 5 * delta;\n\n            // Idle floating animation\n            appleGroup.position.y = Math.sin(state.time) * 0.1;\n\n            // Leaf Shader Update\n            leafMat.uniforms.time.value = state.time;\n\n            // Glitch Effect logic\n            if (state.isGlitching) {\n                // Jitter position\n                appleGroup.position.x = (Math.random() - 0.5) * 0.2;\n                appleGroup.position.z = (Math.random() - 0.5) * 0.2;\n                \n                // Random scale distortion\n                const s = 1 + Math.sin(state.time * 50) * 0.1;\n                appleGroup.scale.set(s, s*0.9, s);\n\n                // Flash wireframe\n                wireMat.opacity = Math.random();\n            } else {\n                // Return to center X/Z\n                appleGroup.position.x += (0 - appleGroup.position.x) * 10 * delta;\n                appleGroup.position.z += (0 - appleGroup.position.z) * 10 * delta;\n                wireMat.opacity = 0.1;\n            }\n\n            renderer.render(scene, camera);\n        }\n\n        animate();\n    </script>\n</body>\n</html>"
  }
}