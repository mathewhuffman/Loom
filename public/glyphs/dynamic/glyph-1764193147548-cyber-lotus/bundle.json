{
  "name": "Cyber Lotus",
  "type": "object",
  "entry": "index.html",
  "files": {
    "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Cyber Lotus</title>\n    <style>\n        html, body {\n            margin: 0;\n            padding: 0;\n            width: 100%;\n            height: 100%;\n            background: transparent;\n            overflow: hidden;\n            font-family: monospace;\n        }\n        canvas {\n            display: block;\n            width: 100%;\n            height: 100%;\n            outline: none;\n        }\n        #ui {\n            position: absolute;\n            bottom: 20px;\n            left: 20px;\n            color: #00ffff;\n            pointer-events: none;\n            text-shadow: 0 0 5px #00ffff;\n            opacity: 0.8;\n            font-size: 12px;\n        }\n    </style>\n</head>\n<body>\n    <div id=\"ui\">SYSTEM: ONLINE<br>INPUT: TRACKING</div>\n    <script type=\"module\">\n        import * as THREE from 'https://esm.sh/three@0.168.0';\n\n        // --- STATE & CONFIG ---\n        const config = {\n            colorCore: 0x001133,\n            colorPetal: 0x00ffff,\n            colorGlow: 0x5500ff,\n            bloomSpeed: 0.05,\n            rotationSensitivity: 0.001\n        };\n\n        const state = {\n            mouseX: 0,\n            mouseY: 0,\n            isHovering: false,\n            bloomLevel: 0, // 0 to 1\n            targetBloom: 0,\n            time: 0\n        };\n\n        // --- SCENE SETUP ---\n        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n        renderer.setSize(window.innerWidth, window.innerHeight);\n        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n        document.body.appendChild(renderer.domElement);\n\n        const scene = new THREE.Scene();\n        \n        // Camera setup for an object view\n        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);\n        camera.position.set(0, 3, 8);\n        camera.lookAt(0, 0, 0);\n\n        // --- MATERIALS ---\n        // Holographic petal material\n        const petalMaterial = new THREE.MeshPhysicalMaterial({\n            color: config.colorGlow,\n            emissive: 0x000044,\n            metalness: 0.9,\n            roughness: 0.1,\n            transmission: 0.6, // Glass-like\n            thickness: 1.0,\n            transparent: true,\n            opacity: 0.9,\n            side: THREE.DoubleSide,\n        });\n\n        const wireframeMaterial = new THREE.MeshBasicMaterial({\n            color: config.colorPetal,\n            wireframe: true,\n            transparent: true,\n            opacity: 0.3,\n            blending: THREE.AdditiveBlending\n        });\n\n        const coreMaterial = new THREE.MeshBasicMaterial({\n            color: 0xffffff,\n            wireframe: true,\n            transparent: true,\n            opacity: 0.8\n        });\n\n        // --- GEOMETRY GENERATION ---\n        const flowerGroup = new THREE.Group();\n        scene.add(flowerGroup);\n\n        // Helper to create a single petal\n        function createPetal(width, height, curvature) {\n            // Create a curved shape\n            const shape = new THREE.Shape();\n            shape.moveTo(0, 0);\n            shape.quadraticCurveTo(width / 2, height / 2, 0, height);\n            shape.quadraticCurveTo(-width / 2, height / 2, 0, 0);\n\n            const geometry = new THREE.ShapeGeometry(shape, 12);\n            \n            // Bend the geometry to make it cup-shaped\n            const positions = geometry.attributes.position;\n            for (let i = 0; i < positions.count; i++) {\n                const x = positions.getX(i);\n                const y = positions.getY(i);\n                const z = positions.getZ(i);\n                // Simple parabolic bend\n                const bend = (x * x) * curvature;\n                positions.setZ(i, z + bend);\n            }\n            geometry.computeVertexNormals();\n\n            const mesh = new THREE.Mesh(geometry, petalMaterial);\n            const wire = new THREE.Mesh(geometry, wireframeMaterial);\n            mesh.add(wire);\n            \n            // Pivot adjustment so it rotates from the base\n            mesh.geometry.translate(0, 0, 0);\n            \n            // Wrapper to handle pivot rotation easily\n            const pivot = new THREE.Object3D();\n            pivot.add(mesh);\n            return { pivot, mesh };\n        }\n\n        // Build the flower layers\n        const petals = [];\n        const layers = [\n            { count: 6, scale: 1.0, tilt: 0.5, y: 0.0, color: 0x00ffff },\n            { count: 8, scale: 1.5, tilt: 0.8, y: -0.1, color: 0x0088ff },\n            { count: 12, scale: 2.0, tilt: 1.1, y: -0.2, color: 0x0044ff }\n        ];\n\n        layers.forEach((layer, layerIndex) => {\n            for (let i = 0; i < layer.count; i++) {\n                const angle = (i / layer.count) * Math.PI * 2;\n                const { pivot, mesh } = createPetal(0.8 * layer.scale, 2.5 * layer.scale, 0.5);\n                \n                // Position in circle\n                pivot.position.y = layer.y;\n                pivot.rotation.y = angle;\n                \n                // Initial tilt (closed state)\n                // We store base rotation in userData to animate it later\n                pivot.userData = {\n                    baseTilt: Math.PI / 4 + (layerIndex * 0.1),\n                    bloomTilt: Math.PI / 2.5 + (layerIndex * 0.2),\n                    angleOffset: angle,\n                    layer: layerIndex\n                };\n                \n                // Rotate the mesh relative to pivot to face outward\n                mesh.rotation.x = -Math.PI / 4; // Initial closed stance\n\n                flowerGroup.add(pivot);\n                petals.push({ pivot, mesh });\n            }\n        });\n\n        // Center Core (Stamen)\n        const coreGeo = new THREE.IcosahedronGeometry(0.5, 1);\n        const core = new THREE.Mesh(coreGeo, coreMaterial);\n        flowerGroup.add(core);\n\n        // Lights\n        const pointLight = new THREE.PointLight(0x00ffff, 2, 10);\n        pointLight.position.set(0, 2, 0);\n        scene.add(pointLight);\n\n        const ambientLight = new THREE.AmbientLight(0x404040, 2);\n        scene.add(ambientLight);\n\n        // Particles\n        const particleCount = 200;\n        const particlesGeo = new THREE.BufferGeometry();\n        const posArray = new Float32Array(particleCount * 3);\n        for(let i=0; i<particleCount*3; i++) {\n            posArray[i] = (Math.random() - 0.5) * 10;\n        }\n        particlesGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));\n        const particlesMat = new THREE.PointsMaterial({\n            size: 0.05,\n            color: 0x00ffff,\n            transparent: true,\n            opacity: 0.6,\n            blending: THREE.AdditiveBlending\n        });\n        const particlesMesh = new THREE.Points(particlesGeo, particlesMat);\n        scene.add(particlesMesh);\n\n        // --- INPUT HANDLING ---\n        function onMouseMove(event) {\n            // Normalize mouse -1 to 1\n            state.mouseX = (event.clientX / window.innerWidth) * 2 - 1;\n            state.mouseY = -(event.clientY / window.innerHeight) * 2 + 1;\n            \n            // Calculate distance from center for bloom effect\n            const dist = Math.sqrt(state.mouseX*state.mouseX + state.mouseY*state.mouseY);\n            // Bloom: Open when mouse is near center, close when far? \n            // Let's do: Open when mouse moves (excitation) or just map Y axis to open/close for control.\n            // User request: Interactive. Let's make it follow mouse and open based on proximity to center.\n            \n            // Closer to center = more open (bloom)\n            // Clamped 0 to 1\n            state.targetBloom = Math.max(0, Math.min(1, 1.2 - dist));\n            \n            updateUI();\n        }\n\n        function updateUI() {\n            const ui = document.getElementById('ui');\n            ui.innerHTML = `SYSTEM: ONLINE<br>BLOOM: ${(state.bloomLevel * 100).toFixed(0)}%<br>X: ${state.mouseX.toFixed(2)} Y: ${state.mouseY.toFixed(2)}`;\n        }\n\n        window.addEventListener('mousemove', onMouseMove);\n        window.addEventListener('resize', () => {\n            camera.aspect = window.innerWidth / window.innerHeight;\n            camera.updateProjectionMatrix();\n            renderer.setSize(window.innerWidth, window.innerHeight);\n        });\n\n        // --- ANIMATION LOOP ---\n        const clock = new THREE.Clock();\n\n        function animate() {\n            requestAnimationFrame(animate);\n            const dt = clock.getDelta();\n            state.time += dt;\n\n            // Smoothly interpolate bloom level\n            state.bloomLevel += (state.targetBloom - state.bloomLevel) * dt * 2.0;\n\n            // Rotate entire flower based on mouse X\n            const targetRotY = state.mouseX * 0.5;\n            const targetRotX = state.mouseY * 0.5;\n            \n            flowerGroup.rotation.y += (targetRotY - flowerGroup.rotation.y) * dt * 2.0;\n            flowerGroup.rotation.x += (targetRotX - flowerGroup.rotation.x) * dt * 2.0;\n            \n            // Idle rotation\n            flowerGroup.rotation.z = Math.sin(state.time * 0.2) * 0.1;\n\n            // Animate Petals\n            petals.forEach((p, i) => {\n                const { pivot, mesh } = p;\n                const data = pivot.userData;\n                \n                // Breathing effect\n                const breath = Math.sin(state.time * 1.5 + data.layer) * 0.05;\n                \n                // Calculate target angle based on bloom level\n                // Closed: -PI/4, Open: PI/6\n                const closedAngle = -Math.PI / 3;\n                const openAngle = Math.PI / 4;\n                \n                const currentTarget = THREE.MathUtils.lerp(closedAngle, openAngle, state.bloomLevel);\n                \n                // Apply rotation to mesh (the flap)\n                mesh.rotation.x = currentTarget + breath;\n            });\n\n            // Animate Core\n            core.rotation.y += dt;\n            core.rotation.z += dt * 0.5;\n            const pulse = 1 + Math.sin(state.time * 5) * 0.1 * state.bloomLevel;\n            core.scale.setScalar(pulse);\n\n            // Animate Particles\n            particlesMesh.rotation.y = state.time * 0.05;\n            const positions = particlesMesh.geometry.attributes.position.array;\n            for(let i=1; i<positions.length; i+=3) {\n                // Float up and reset\n                positions[i] += dt * 0.5;\n                if(positions[i] > 5) positions[i] = -5;\n            }\n            particlesMesh.geometry.attributes.position.needsUpdate = true;\n\n            renderer.render(scene, camera);\n        }\n\n        animate();\n    </script>\n</body>\n</html>"
  }
}