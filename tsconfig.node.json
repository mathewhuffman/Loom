{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "target": "ES2020"
  },
  "include": ["main.ts", "preload.ts", "vite.config.ts", "src/types/**/*.ts"]
}

