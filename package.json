{
  "name": "loom",
  "version": "0.2.6",
  "description": "LOOM — A spatial shell for weaving digital reality",
  "author": "LOOM Team",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mathewhuffman/loom.git"
  },
  "scripts": {
    "compile": "tsc -p electron-main.tsconfig.json",
    "dev": "npm run compile && concurrently --kill-others-on-fail \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:clean": "taskkill /F /IM electron.exe /T 2>nul & npm run dev",
    "start": "electron .",
    "build": "npm run compile && vite build && electron-builder",
    "build:win": "npm run compile && vite build && electron-builder --win",
    "build:mac": "npm run compile && vite build && electron-builder --mac",
    "build:linux": "npm run compile && vite build && electron-builder --linux",
    "release": "npm run compile && vite build && electron-builder --publish always",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.loom.desktop",
    "productName": "Loom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "CHANGELOG.md"
    ],
    "extraResources": [
      {
        "from": "bundled-glyphs",
        "to": "bundled-glyphs",
        "filter": ["**/*"]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "mathewhuffman",
      "repo": "Loom",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^9.88.0",
    "@react-three/fiber": "^8.16.8",
    "diff": "^8.0.2",
    "electron-as-wallpaper": "^2.0.3",
    "electron-updater": "^6.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sucrase": "^3.35.1",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.19.25",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  }
}
