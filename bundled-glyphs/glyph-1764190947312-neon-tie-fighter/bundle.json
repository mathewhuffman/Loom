{
  "name": "Neon Tie Fighter",
  "type": "background",
  "entry": "index.html",
  "files": {
    "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Neon Tie Fighter</title>\n  <style>\n    html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #000; font-family: 'Courier New', Courier, monospace; user-select: none; }\n    canvas { display: block; width: 100%; height: 100%; }\n    \n    #hud {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      pointer-events: none;\n      box-sizing: border-box;\n      padding: 20px;\n    }\n\n    .hud-text {\n      color: #00ff00;\n      text-shadow: 0 0 5px #00ff00, 0 0 10px #00ff00;\n      font-weight: bold;\n      letter-spacing: 2px;\n    }\n\n    #score-board {\n      font-size: 24px;\n      position: absolute;\n      top: 30px;\n      left: 30px;\n    }\n\n    #controls-hint {\n      position: absolute;\n      bottom: 30px;\n      left: 50%;\n      transform: translateX(-50%);\n      font-size: 14px;\n      color: rgba(0, 255, 255, 0.7);\n      text-shadow: 0 0 5px cyan;\n    }\n\n    #game-over {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      text-align: center;\n      display: none;\n      background: rgba(0, 0, 0, 0.85);\n      padding: 40px;\n      border: 2px solid #ff0066;\n      box-shadow: 0 0 20px #ff0066;\n    }\n\n    #game-over h1 {\n      color: #ff0066;\n      font-size: 48px;\n      margin: 0 0 20px 0;\n      text-shadow: 0 0 10px #ff0066;\n      text-transform: uppercase;\n    }\n\n    #game-over p {\n      color: #fff;\n      font-size: 18px;\n      animation: blink 1s infinite;\n    }\n\n    @keyframes blink {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.5; }\n    }\n  </style>\n</head>\n<body>\n  <div id=\"hud\">\n    <div id=\"score-board\" class=\"hud-text\">SCORE: 0000</div>\n    <div id=\"controls-hint\">MOUSE to Fly &bull; CLICK to Shoot</div>\n  </div>\n\n  <div id=\"game-over\">\n    <h1>SYSTEM FAILURE</h1>\n    <p>[ CLICK TO REBOOT SYSTEM ]</p>\n  </div>\n\n  <script type=\"module\">\n    import * as THREE from 'https://esm.sh/three@0.168.0';\n    import { EffectComposer } from 'https://esm.sh/three@0.168.0/examples/jsm/postprocessing/EffectComposer.js';\n    import { RenderPass } from 'https://esm.sh/three@0.168.0/examples/jsm/postprocessing/RenderPass.js';\n    import { UnrealBloomPass } from 'https://esm.sh/three@0.168.0/examples/jsm/postprocessing/UnrealBloomPass.js';\n\n    // --- CONFIGURATION ---\n    const COLORS = {\n      player: 0x00ff00,\n      laser: 0xff0066,\n      asteroid: 0x00ffff,\n      star: 0xffffff\n    };\n    \n    // --- STATE ---\n    const state = {\n      score: 0,\n      isPlaying: true,\n      mouse: new THREE.Vector2(),\n      targetPos: new THREE.Vector2(),\n      lasers: [],\n      asteroids: [],\n      lastShot: 0,\n      lastSpawn: 0,\n      difficulty: 1.0\n    };\n\n    // --- SCENE SETUP ---\n    const scene = new THREE.Scene();\n    scene.fog = new THREE.FogExp2(0x050510, 0.02);\n\n    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 200);\n    camera.position.set(0, 2, 8);\n\n    const renderer = new THREE.WebGLRenderer({ antialias: false, powerPreference: \"high-performance\" });\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    document.body.appendChild(renderer.domElement);\n\n    // --- POST PROCESSING (BLOOM) ---\n    const renderScene = new RenderPass(scene, camera);\n    const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.5, 0.4, 0.85);\n    bloomPass.threshold = 0.1;\n    bloomPass.strength = 1.2;\n    bloomPass.radius = 0.5;\n\n    const composer = new EffectComposer(renderer);\n    composer.addPass(renderScene);\n    composer.addPass(bloomPass);\n\n    // --- ASSETS ---\n    // 1. Starfield\n    const starGeo = new THREE.BufferGeometry();\n    const starCount = 2000;\n    const starPos = new Float32Array(starCount * 3);\n    for(let i=0; i<starCount*3; i++) {\n      starPos[i] = (Math.random() - 0.5) * 400;\n    }\n    starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));\n    const starMat = new THREE.PointsMaterial({ color: COLORS.star, size: 0.5, transparent: true, opacity: 0.8 });\n    const stars = new THREE.Points(starGeo, starMat);\n    scene.add(stars);\n\n    // 2. Player Ship (Procedural Geometry)\n    const shipGroup = new THREE.Group();\n    \n    // Cockpit\n    const cockpitGeo = new THREE.IcosahedronGeometry(0.8, 1);\n    const cockpitMat = new THREE.MeshBasicMaterial({ color: 0x000000 });\n    const cockpitWire = new THREE.MeshBasicMaterial({ color: COLORS.player, wireframe: true });\n    const cockpit = new THREE.Mesh(cockpitGeo, cockpitMat);\n    cockpit.add(new THREE.Mesh(cockpitGeo, cockpitWire));\n    shipGroup.add(cockpit);\n\n    // Wings\n    const wingGeo = new THREE.CylinderGeometry(1.5, 1.5, 0.1, 6);\n    wingGeo.rotateX(Math.PI / 2);\n    const wingMat = new THREE.MeshBasicMaterial({ color: 0x000000 });\n    const wingWire = new THREE.MeshBasicMaterial({ color: COLORS.player, wireframe: true });\n    \n    const leftWing = new THREE.Mesh(wingGeo, wingMat);\n    leftWing.add(new THREE.Mesh(wingGeo, wingWire));\n    leftWing.position.set(-1.8, 0, 0);\n    \n    const rightWing = new THREE.Mesh(wingGeo, wingMat);\n    rightWing.add(new THREE.Mesh(wingGeo, wingWire));\n    rightWing.position.set(1.8, 0, 0);\n\n    // Struts\n    const strutGeo = new THREE.CylinderGeometry(0.2, 0.2, 3.6, 8);\n    strutGeo.rotateZ(Math.PI / 2);\n    const strut = new THREE.Mesh(strutGeo, new THREE.MeshBasicMaterial({ color: 0x111111 }));\n    \n    shipGroup.add(leftWing, rightWing, strut);\n    scene.add(shipGroup);\n\n    // --- GAMEPLAY FUNCTIONS ---\n\n    function spawnAsteroid() {\n      if (!state.isPlaying) return;\n      \n      const geo = new THREE.IcosahedronGeometry(Math.random() * 1.5 + 0.5, 0);\n      const mat = new THREE.MeshBasicMaterial({ color: 0x000000 });\n      const wire = new THREE.MeshBasicMaterial({ color: COLORS.asteroid, wireframe: true });\n      \n      const asteroid = new THREE.Mesh(geo, mat);\n      asteroid.add(new THREE.Mesh(geo, wire));\n      \n      // Spawn in distance\n      asteroid.position.z = -100;\n      asteroid.position.x = (Math.random() - 0.5) * 40;\n      asteroid.position.y = (Math.random() - 0.5) * 25;\n      \n      // Metadata for animation\n      asteroid.userData = {\n        rotSpeed: { x: Math.random() * 0.05, y: Math.random() * 0.05 },\n        speed: 0.5 + (Math.random() * 0.5) + (state.difficulty * 0.1)\n      };\n\n      scene.add(asteroid);\n      state.asteroids.push(asteroid);\n    }\n\n    function shoot() {\n      if (!state.isPlaying) return;\n\n      const laserGeo = new THREE.CylinderGeometry(0.08, 0.08, 4, 8);\n      laserGeo.rotateX(Math.PI / 2);\n      const laserMat = new THREE.MeshBasicMaterial({ color: COLORS.laser });\n      \n      // Create two lasers\n      const l1 = new THREE.Mesh(laserGeo, laserMat);\n      const l2 = new THREE.Mesh(laserGeo, laserMat);\n      \n      l1.position.copy(shipGroup.position);\n      l1.position.x -= 1.7;\n      l2.position.copy(shipGroup.position);\n      l2.position.x += 1.7;\n      \n      scene.add(l1, l2);\n      state.lasers.push(l1, l2);\n    }\n\n    function updateScore(points) {\n      state.score += points;\n      document.getElementById('score-board').innerText = 'SCORE: ' + state.score.toString().padStart(4, '0');\n      \n      // Increase difficulty slightly\n      if (state.score % 500 === 0) state.difficulty += 0.5;\n    }\n\n    function gameOver() {\n      state.isPlaying = false;\n      document.getElementById('game-over').style.display = 'block';\n      document.getElementById('hud').style.opacity = '0.2';\n    }\n\n    function resetGame() {\n      state.score = 0;\n      state.difficulty = 1.0;\n      state.isPlaying = true;\n      updateScore(0);\n      \n      document.getElementById('game-over').style.display = 'none';\n      document.getElementById('hud').style.opacity = '1';\n\n      // Clear entities\n      state.asteroids.forEach(a => scene.remove(a));\n      state.asteroids = [];\n      state.lasers.forEach(l => scene.remove(l));\n      state.lasers = [];\n      \n      shipGroup.position.set(0,0,0);\n      shipGroup.rotation.set(0,0,0);\n    }\n\n    // --- INPUT HANDLING ---\n    window.addEventListener('mousemove', (e) => {\n      state.mouse.x = (e.clientX / window.innerWidth) * 2 - 1;\n      state.mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;\n    });\n\n    window.addEventListener('mousedown', () => {\n      if (!state.isPlaying) {\n        resetGame();\n      } else {\n        shoot();\n      }\n    });\n\n    window.addEventListener('resize', () => {\n      camera.aspect = window.innerWidth / window.innerHeight;\n      camera.updateProjectionMatrix();\n      renderer.setSize(window.innerWidth, window.innerHeight);\n      composer.setSize(window.innerWidth, window.innerHeight);\n    });\n\n    // --- MAIN LOOP ---\n    const clock = new THREE.Clock();\n\n    function animate() {\n      requestAnimationFrame(animate);\n      \n      const delta = clock.getDelta();\n      const now = clock.getElapsedTime();\n\n      if (state.isPlaying) {\n        // 1. Ship Movement (Smooth Lerp)\n        const limitX = 12;\n        const limitY = 6;\n        state.targetPos.x = state.mouse.x * limitX;\n        state.targetPos.y = state.mouse.y * limitY;\n        \n        shipGroup.position.x += (state.targetPos.x - shipGroup.position.x) * 5 * delta;\n        shipGroup.position.y += (state.targetPos.y - shipGroup.position.y) * 5 * delta;\n        \n        // Banking effect\n        shipGroup.rotation.z = (shipGroup.position.x - state.targetPos.x) * 0.15;\n        shipGroup.rotation.x = (shipGroup.position.y - state.targetPos.y) * 0.1;\n\n        // 2. Spawn Asteroids\n        if (now - state.lastSpawn > Math.max(0.2, 1.0 - (state.difficulty * 0.1))) {\n          spawnAsteroid();\n          state.lastSpawn = now;\n        }\n\n        // 3. Move Lasers\n        for (let i = state.lasers.length - 1; i >= 0; i--) {\n          const l = state.lasers[i];\n          l.position.z -= 60 * delta;\n          if (l.position.z < -150) {\n            scene.remove(l);\n            state.lasers.splice(i, 1);\n          }\n        }\n\n        // 4. Move Asteroids & Collisions\n        const playerHitBox = 1.5;\n        \n        for (let i = state.asteroids.length - 1; i >= 0; i--) {\n          const a = state.asteroids[i];\n          a.position.z += (20 + (state.difficulty * 2)) * delta;\n          a.rotation.x += a.userData.rotSpeed.x;\n          a.rotation.y += a.userData.rotSpeed.y;\n\n          // Collision: Player vs Asteroid\n          if (a.position.distanceTo(shipGroup.position) < playerHitBox) {\n            gameOver();\n          }\n\n          // Collision: Laser vs Asteroid\n          let hit = false;\n          for (let j = state.lasers.length - 1; j >= 0; j--) {\n            const l = state.lasers[j];\n            if (l.position.distanceTo(a.position) < 2.0) {\n              // Destroy\n              scene.remove(a);\n              state.asteroids.splice(i, 1);\n              scene.remove(l);\n              state.lasers.splice(j, 1);\n              updateScore(100);\n              hit = true;\n              break;\n            }\n          }\n\n          if (!hit && a.position.z > 10) {\n            scene.remove(a);\n            state.asteroids.splice(i, 1);\n          }\n        }\n      } else {\n        // Game Over Animation (Spin)\n        shipGroup.rotation.z += 1 * delta;\n        shipGroup.rotation.y += 1 * delta;\n      }\n\n      // Move Stars for speed effect\n      const speed = state.isPlaying ? 1 : 0.1;\n      const positions = stars.geometry.attributes.position.array;\n      for(let i=2; i<positions.length; i+=3) {\n        positions[i] += 20 * speed * delta;\n        if (positions[i] > 50) positions[i] = -350;\n      }\n      stars.geometry.attributes.position.needsUpdate = true;\n\n      composer.render();\n    }\n\n    animate();\n  </script>\n</body>\n</html>"
  }
}